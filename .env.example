# Astra-Local Configuration Example
# Copy this file to .env and insert your desired provider API keys.

# ==========================================
# 1. AI Providers & Keys
# ==========================================
# Google Gemini API key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key - Free in 2 minutes (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Local / Cloud Ollama (https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# OLLAMA_API_KEY=your_ollama_cloud_key_if_using_cloud

# Generic OpenAI Compatible (optional)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# ==========================================
# 2. Provider Order & Failover
# ==========================================
# Fallback order: skips any provider with missing keys/endpoints.
# Transitions to next provider only on true 429, 503, timeout, or connection errors.
PROVIDER_ORDER=ollama_local,groq,openrouter,gemini

# ==========================================
# 3. Model Architecture & Model Split
# ==========================================
# Normal agent loop model (fast text & tool calling)
TEXT_MODEL=gemini-3.8-flash

# Takeover Mode dedicated model (only active when /takeover or Ctrl+Alt+T is used)
TAKEOVER_MODEL=gemini-2.5-computer-use-preview-10-2025

# Gemini Thinking Level (none, low, medium, high)
THINKING_LEVEL=low

# ==========================================
# 4. Automation & Vision Settings
# ==========================================
# Vision mode: false by default (prefers deep links, PowerShell, Playwright DOM, UIA control names)
USE_VISION=false

# Offline Stockfish path for Chess Benchmark ladder
STOCKFISH_PATH=stockfish

# Execution & safety limits
MAX_STEPS=8
MAX_DESKTOP_ACTIONS=25
POWERSHELL_TIMEOUT=60
PYTHON_TIMEOUT=60

# ==========================================
# 5. Quota Tracking & Caching
# ==========================================
# Local counter only warns, never blocks providers. Configure warning threshold below:
QUOTA_WARN_THRESHOLD=20
QUOTA_PER_DAY=1000
CACHE_TTL_SECONDS=600

# ==========================================
# 6. Safety & Workspaces
# ==========================================
# If true, auto-approves harmless read-only actions. Sensitive operations ALWAYS ask y/n.
AUTO_APPROVE_SAFE=true
WORKSPACE_DIR=%USERPROFILE%\astra_workspace
BROWSER_USER_DATA_DIR=%USERPROFILE%\.astra_local\browser_data

# ==========================================
# 7. Voice Assistant Configuration
# ==========================================
# Enable voice listening automatically on startup (or launch with `superlocal --voice`)
VOICE_ENABLED=false

# Wake Words (comma-separated, case-insensitive)
WAKE_WORDS=hey superlocal,hey astra,superlocal
# CUSTOM_WAKE_WORD=superlocal

# Push-to-Talk fallback key (e.g. f9, space, ctrl)
VOICE_PTT_KEY=f9

# Speech-to-Text: faster-whisper (tiny, base, small; language auto-detects Tamil, English, etc.)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=

# Text-to-Speech: "auto" uses Piper if path configured, otherwise Windows SAPI5 (pyttsx3)
TTS_ENGINE=auto
TTS_RATE=180
TTS_VOLUME=1.0
# TTS_VOICE=
# PIPER_PATH=C:\path\to\piper.exe
# PIPER_MODEL=C:\path\to\en_US-lessac-medium.onnx

# Audio Devices: index or name substring from `/voice devices` (blank = default)
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# VAD & Noise Filtering
VAD_THRESHOLD=0.5
MIN_RMS=0.008
MIN_SPEECH_DURATION=0.6
TRAILING_SILENCE=0.8
CONVERSATION_TIMEOUT=20.0

# Gemini Live bidirectional streaming model
LIVE_MODEL=gemini-2.0-flash-exp

# Audio Privacy & Retention: false = never save audio; true = auto-purge after 24h
VOICE_SAVE_AUDIO=false

# ==========================================
# 8. Autopilot End-to-End Mode
# ==========================================
# Budgets per job
AUTOPILOT_MAX_STEPS=40
AUTOPILOT_MAX_MINUTES=30
AUTOPILOT_MAX_MODEL_CALLS=25
AUTOPILOT_MAX_DESKTOP_ACTIONS=30

# Automatically start low-risk plans without asking y/n
AUTO_APPROVE_LOW_RISK=false

# ==========================================
# 9. Computer Mode (@computer)
# ==========================================
COMPUTER_DEFAULT_EFFORT=medium
COMPUTER_EFFORT_LOW_MAX_ACTIONS=10
COMPUTER_EFFORT_MED_MAX_ACTIONS=30
COMPUTER_EFFORT_HIGH_MAX_ACTIONS=80
COMPUTER_EFFORT_HIGH_MAX_MINUTES=60
COMPUTER_ACTION_PAUSE=0.3
COMPUTER_VISION_MAX_WIDTH=1024
COMPUTER_VISION_JPEG_QUALITY=50
SAVE_SCREENS=false

# ==========================================
# 10. Poki Player Configuration
# ==========================================
POKI_MAX_MINUTES=20
POKI_MAX_RUNS=50
POKI_TARGET_FPS=24
SAVE_VIDEO=false

# ==========================================
# 11. PC Optimizer Configuration
# ==========================================
OPTIMIZER_CLEAN_MIN_AGE_DAYS=7
OPTIMIZER_SCHEDULE_DAY=Sunday
